# Files to exclude from the VSIX package.
# vsce packages everything NOT listed here, so the package contains only:
#   package.json, package.nls*.json, out/extension/, out/webview/,
#   icons/, README*.md, SUPPORT*.md, SECURITY*.md, CHANGELOG*.md, LICENSE,
#   node_modules/libsql/** (the engine's JS),
#   node_modules/@libsql/<this platform's binary package>/** (index.node),
#   node_modules/@neon-rs/load/** and node_modules/detect-libc/**
#     (libsql's only runtime require dependencies after the binary).
#
# The database engine is the libSQL C fork, via the `libsql` npm package — the
# ONLY engine (deliberately no better-sqlite3 fallback; see
# src/extension/adapter/sqliteAdapter.ts). The engine's JS loader
# (`node_modules/libsql/index.js`) resolves the binary at require time via
# `@neon-rs/load`'s currentTarget() (with a musl→gnu remap on Linux), then
# `require('@libsql/<target>')`. Each `@libsql/<target>` package ships exactly
# one file that matters: `index.node` (plus its own package.json declaring
# os/cpu, which vsce uses for target pruning).
#
# MULTI-PLATFORM: unlike better-sqlite3 (which shipped every platform's prebuild
# inside ONE package and needed a single untargeted VSIX), libsql publishes one
# optional binary package per platform. The repository therefore builds one VSIX
# per target (`npm run package:target`), and each VSIX is expected to carry only
# its own `@libsql/<target>` binary. `vsce package --target <t>` prunes
# node_modules packages whose os/cpu fields exclude the target platform — which
# removes the other eight `@libsql/*` binaries automatically; the re-includes
# below open the gate for node_modules and vsce's target pruning closes it per
# platform. `scripts/verify-vsix.js` asserts the pruned layout for every target.
.vscodeignore
.gitignore
node_modules/**
# The engine JS + its two runtime dependencies are re-included by name; the
# per-platform binaries are re-included as a group and then pruned by
# `vsce --target` down to the one matching the package's target platform.
#
#   libsql/           index.js (loader), auth.js, sqlite-error.js, promise.js,
#                     types/, package.json, LICENSE — no build sources exist
#   @libsql/<target>/ index.node + package.json (os/cpu used for pruning)
#   @neon-rs/load/    dist/index.js — resolves the binary path at require time
#   detect-libc/      lib/ — musl vs glibc detection for the Linux remap
!node_modules/libsql/**
!node_modules/@libsql/**
!node_modules/@neon-rs/load/**
!node_modules/detect-libc/**
.git/**
.git/**/*
src/**
webview/**
test/**
scripts/**
out/test/**
tsconfig.json
tsconfig.extension.json
tsconfig.test.json
vite.config.ts
.eslintrc.cjs
*.ts
*.tsx
*.js.map
*.ts.map
*.tsbuildinfo
# Local scratch/staging directories must never reach the package.
.vsix-stage/**
*.vsix
# The packaging OUTPUT directory. It holds finished archives, and anything a user
# happens to put beside them -- sample databases, notes -- which is not extension
# content. Without this, `vsce package` scans its own output directory and sweeps
# stray files into the archive.
VSIX/**
# Local convenience wrappers for running the tooling from the repository root.
# `package.bat` just runs `npm run package`, and `vsce.bat` is a shim that adds
# the output path; neither is part of the extension at runtime.
package.bat
vsce.bat
# Any other dot-directory at the root is local tooling/scratch (backups, caches);
# nothing the extension needs at runtime starts with a dot.
.*/**
# Database files are user data (sample/test databases kept beside the source),
# never extension assets. They must not be shipped inside the VSIX.
#
# The second group matters because SQLite's WAL mode writes sidecars NEXT TO the
# database: `<name>.db-wal` and `<name>.db-shm`. Those do not match `*.db`, so
# without an explicit rule an open database can leak a journal into the package
# even when the database itself is excluded.
*.db
*.sqlite
*.sqlite3
*.libsql
*.db-wal
*.db-shm
*-wal
*-shm
*.journal
