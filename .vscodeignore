# Files to exclude from the VSIX package.
# vsce packages everything NOT listed here, so the package contains only:
#   package.json, package.nls*.json, out/extension/, out/webview/,
#   icons/, README*.md, SUPPORT*.md, SECURITY*.md, CHANGELOG*.md, LICENSE,
#   node_modules/@tursodatabase/**.
#
# The database engine is Turso Database (`@tursodatabase/database`), a NATIVE
# local-file engine. sql.js is gone (out/vendor/sqljs/ and node_modules/sql.js
# must never ship), and so are @libsql/** and libsql/** — replaced wholesale.
# `@libsql/client-wasm` was also evaluated and rejected: it cannot open a file
# (absolute paths fail with SQLITE_CANTOPEN and a relative one silently becomes
# an in-memory DB that never reaches disk).
#
# node_modules is excluded by default, but the Turso runtime (its JS wrapper plus
# the platform-specific `@tursodatabase/database-<platform>` binary, which npm
# nests under it) is re-included via the `!` override below — the installed
# extension loads it directly from node_modules. This is the only runtime
# dependency: the engine has no non-optional third-party dependencies of its own.
#
# MULTI-PLATFORM: only ONE platform's native binary can be present per build, so
# a single VSIX cannot serve every OS/arch. The GitHub Actions workflow
# (.github/workflows/release.yml) therefore packages one targeted VSIX per
# platform with `vsce package --target <target>`; VS Code picks the matching one.
.vscodeignore
.gitignore
node_modules/**
!node_modules/@tursodatabase/**
.git/**
.git/**/*
src/**
webview/**
test/**
scripts/**
out/test/**
tsconfig.json
tsconfig.extension.json
tsconfig.test.json
vite.config.ts
.eslintrc.cjs
*.ts
*.tsx
*.js.map
*.ts.map
*.tsbuildinfo
# Local scratch/staging directories must never reach the package.
.vsix-stage/**
*.vsix
# The packaging OUTPUT directory. It holds finished archives, and anything a user
# happens to put beside them -- sample databases, notes -- which is not extension
# content. Without this, `vsce package` scans its own output directory and sweeps
# stray files into the archive.
VSIX/**
# Local convenience wrappers for running the tooling from the repository root.
# `package.bat` just runs `npm run package`, and `vsce.bat` is a shim that adds
# the output path; neither is part of the extension at runtime.
package.bat
vsce.bat
# Any other dot-directory at the root is local tooling/scratch (backups, caches);
# nothing the extension needs at runtime starts with a dot.
.*/**
# Database files are user data (sample/test databases kept beside the source),
# never extension assets. They must not be shipped inside the VSIX.
#
# The second group matters because SQLite's WAL mode writes sidecars NEXT TO the
# database: `<name>.db-wal` and `<name>.db-shm`. Those do not match `*.db`, so
# without an explicit rule an open database can leak a journal into the package
# even when the database itself is excluded.
*.db
*.sqlite
*.sqlite3
*.libsql
*.db-wal
*.db-shm
*-wal
*-shm
*.journal