# Build output — regenerated by `npm run compile`, never committed.
out/

# Dependencies.
node_modules/

# Packaged artifact — produced by `npm run package`.
*.vsix
.vsix-stage/

# TypeScript incremental build info.
*.tsbuildinfo

# Logs and editor scratch space.
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Local database files are user data, not source. They are excluded from the
# VSIX for the same reason (see .vscodeignore).
*.db
*.sqlite
*.sqlite3
*.libsql