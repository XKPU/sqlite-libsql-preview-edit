  "extends": "./tsconfig.extension.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./out/test",
    "rootDir": ".",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "types": [
      "node"
    ]
  },
  "include": [
    "test/**/*.ts",
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "dist",
    "webview"
  ]
}
